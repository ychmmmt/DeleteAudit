<Window x:Class="DeleteAudit.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:DeleteAudit.Viewer"
        Title="DeleteAudit — 审计查看器"
        Height="760"
        Width="1240"
        MinHeight="620"
        MinWidth="980">
    <Window.Resources>
        <viewer:UnknownValueConverter x:Key="UnknownValue" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="VirtualizedDataGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <Style x:Key="FilterLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ErrorText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MetricBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFF4CC"
                BorderBrush="#EAAA08"
                BorderThickness="0,0,0,1"
                Padding="12,9">
            <TextBlock FontWeight="SemiBold"
                       Foreground="#7A2E0E"
                       Text="{Binding BannerMessage}" />
        </Border>

        <DockPanel Grid.Row="1" Margin="12,8">
            <TextBlock DockPanel.Dock="Left"
                       FontWeight="SemiBold"
                       Text="{Binding DatabaseStatusMessage}" />
            <TextBlock Margin="16,0,0,0"
                       Foreground="#B42318"
                       Text="{Binding ErrorMessage}" />
        </DockPanel>

        <TabControl Grid.Row="2"
                    Margin="12,0,12,12"
                    SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="导入次数" />
                                    <TextBlock FontSize="26"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.ImportCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="删除会话" />
                                    <TextBlock FontSize="26"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.DeleteSessionCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="删除事件" />
                                    <TextBlock FontSize="26"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.DeleteEventCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="Warning 会话" />
                                    <TextBlock FontSize="26"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.WarningSessionCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="Critical 会话" />
                                    <TextBlock FontSize="26"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.CriticalSessionCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="Warning 诊断" />
                                    <TextBlock FontSize="26"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.WarningDiagnosticCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="Error 诊断" />
                                    <TextBlock FontSize="26"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.ErrorDiagnosticCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricBorder}">
                                <StackPanel>
                                    <TextBlock Text="最近导入（UTC）" />
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding Dashboard.Summary.LastImportStartedUtc, Converter={StaticResource UnknownValue}}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel Margin="4,18,4,0"
                                    Orientation="Horizontal">
                            <Button Command="{Binding Dashboard.ImportCommand}"
                                    Content="选择单个 XML / EVTX 并导入"
                                    Padding="14,8" />
                            <Button Command="{Binding Dashboard.RefreshCommand}"
                                    Content="刷新"
                                    Margin="8,0,0,0"
                                    Padding="14,8" />
                        </StackPanel>
                        <TextBlock Margin="4,10,4,0"
                                   Text="{Binding Dashboard.LastImportStatus}" />
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding Dashboard.ErrorMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Import History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="状态" />
                        <TextBox Width="130"
                                 Text="{Binding ImportHistory.Status, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="起始 UTC" />
                        <TextBox Width="190"
                                 Text="{Binding ImportHistory.FromUtcText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="结束 UTC" />
                        <TextBox Width="190"
                                 Text="{Binding ImportHistory.ToUtcText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="来源路径" />
                        <TextBox Width="180"
                                 Text="{Binding ImportHistory.SourcePathContains, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Command="{Binding ImportHistory.ApplyFiltersCommand}"
                                Content="筛选"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource ErrorText}"
                               Text="{Binding ImportHistory.ErrorMessage}" />
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ImportHistory.Items}"
                              Style="{StaticResource VirtualizedDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="开始 UTC" Binding="{Binding StartedUtc}" />
                            <DataGridTextColumn Header="文件" Binding="{Binding OriginalFileName}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding SourceKind}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="总数" Binding="{Binding TotalRecordCount}" />
                            <DataGridTextColumn Header="成功" Binding="{Binding SuccessRecordCount}" />
                            <DataGridTextColumn Header="忽略" Binding="{Binding IgnoredRecordCount}" />
                            <DataGridTextColumn Header="错误" Binding="{Binding ErrorRecordCount}" />
                            <DataGridTextColumn Header="输出状态" Binding="{Binding OutputStatus, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="来源路径" Binding="{Binding NormalizedSourcePath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ImportHistory.PageStatus}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding ImportHistory.PreviousPageCommand}"
                                    Content="上一页"
                                    Padding="10,4" />
                            <Button Command="{Binding ImportHistory.NextPageCommand}"
                                    Content="下一页"
                                    Margin="8,0,0,0"
                                    Padding="10,4" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Delete Sessions">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="风险" />
                        <ComboBox Width="115"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding DeleteSessions.RiskOptions}"
                                  SelectedValue="{Binding DeleteSessions.SelectedRisk, Mode=TwoWay}"
                                  SelectedValuePath="Value" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="起始 UTC" />
                        <TextBox Width="170" Text="{Binding DeleteSessions.FromUtcText}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="结束 UTC" />
                        <TextBox Width="170" Text="{Binding DeleteSessions.ToUtcText}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="路径" />
                        <TextBox Width="150" Text="{Binding DeleteSessions.PathContains}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="进程" />
                        <TextBox Width="150" Text="{Binding DeleteSessions.ProcessContains}" />
                        <Button Command="{Binding DeleteSessions.ApplyFiltersCommand}"
                                Content="筛选"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource ErrorText}"
                               Text="{Binding DeleteSessions.ErrorMessage}" />
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DeleteSessions.Items}"
                              Style="{StaticResource VirtualizedDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="最后事件 UTC" Binding="{Binding LastEventUtc}" />
                            <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" />
                            <DataGridTextColumn Header="确认项" Binding="{Binding ConfirmedItemCount}" />
                            <DataGridTextColumn Header="保护项" Binding="{Binding ProtectedItemCount}" />
                            <DataGridTextColumn Header="路径范围" Binding="{Binding PathScope, Converter={StaticResource UnknownValue}}" Width="*" />
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessIdentity, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="用户 SID" Binding="{Binding UserSid, Converter={StaticResource UnknownValue}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding DeleteSessions.PageStatus}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding DeleteSessions.PreviousPageCommand}"
                                    Content="上一页"
                                    Padding="10,4" />
                            <Button Command="{Binding DeleteSessions.NextPageCommand}"
                                    Content="下一页"
                                    Margin="8,0,0,0"
                                    Padding="10,4" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Delete Events">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="风险" />
                        <ComboBox Width="115"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding DeleteEvents.RiskOptions}"
                                  SelectedValue="{Binding DeleteEvents.SelectedRisk, Mode=TwoWay}"
                                  SelectedValuePath="Value" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="起始 UTC" />
                        <TextBox Width="170" Text="{Binding DeleteEvents.FromUtcText}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="结束 UTC" />
                        <TextBox Width="170" Text="{Binding DeleteEvents.ToUtcText}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="路径" />
                        <TextBox Width="150" Text="{Binding DeleteEvents.PathContains}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="进程" />
                        <TextBox Width="150" Text="{Binding DeleteEvents.ProcessContains}" />
                        <Button Command="{Binding DeleteEvents.ApplyFiltersCommand}"
                                Content="筛选"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource ErrorText}"
                               Text="{Binding DeleteEvents.ErrorMessage}" />
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DeleteEvents.Items}"
                              SelectedItem="{Binding DeleteEvents.SelectedItem, Mode=TwoWay}"
                              Style="{StaticResource VirtualizedDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="发生 UTC" Binding="{Binding OccurredUtc}" />
                            <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" />
                            <DataGridTextColumn Header="事件 ID" Binding="{Binding SourceEventId}" />
                            <DataGridTextColumn Header="路径" Binding="{Binding FullPath, Converter={StaticResource UnknownValue}}" Width="*" />
                            <DataGridTextColumn Header="对象" Binding="{Binding ObjectKind, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessPath, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="用户" Binding="{Binding UserName, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="归因%" Binding="{Binding AttributionConfidence}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Command="{Binding DeleteEvents.OpenRawXmlCommand}"
                                    Content="查看只读 Raw XML"
                                    Padding="10,4" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding DeleteEvents.PageStatus}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding DeleteEvents.PreviousPageCommand}"
                                    Content="上一页"
                                    Padding="10,4" />
                            <Button Command="{Binding DeleteEvents.NextPageCommand}"
                                    Content="下一页"
                                    Margin="8,0,0,0"
                                    Padding="10,4" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="级别" />
                        <ComboBox Width="120"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding Diagnostics.SeverityOptions}"
                                  SelectedValue="{Binding Diagnostics.SelectedSeverity, Mode=TwoWay}"
                                  SelectedValuePath="Value" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="起始 UTC" />
                        <TextBox Width="180" Text="{Binding Diagnostics.FromUtcText}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="结束 UTC" />
                        <TextBox Width="180" Text="{Binding Diagnostics.ToUtcText}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="文本" />
                        <TextBox Width="220" Text="{Binding Diagnostics.TextContains}" />
                        <Button Command="{Binding Diagnostics.ApplyFiltersCommand}"
                                Content="筛选"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource ErrorText}"
                               Text="{Binding Diagnostics.ErrorMessage}" />
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Diagnostics.Items}"
                              Style="{StaticResource VirtualizedDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="发生 UTC" Binding="{Binding OccurredUtc}" />
                            <DataGridTextColumn Header="级别" Binding="{Binding Severity}" />
                            <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" />
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" />
                            <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                            <DataGridTextColumn Header="记录号" Binding="{Binding RecordOrdinal, Converter={StaticResource UnknownValue}}" />
                            <DataGridTextColumn Header="文件" Binding="{Binding OriginalFileName}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Diagnostics.PageStatus}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding Diagnostics.PreviousPageCommand}"
                                    Content="上一页"
                                    Padding="10,4" />
                            <Button Command="{Binding Diagnostics.NextPageCommand}"
                                    Content="下一页"
                                    Margin="8,0,0,0"
                                    Padding="10,4" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Raw XML">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold"
                                   Text="只读预览：" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding RawXml.ResourceId}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource ErrorText}"
                               Text="{Binding RawXml.ErrorMessage}" />
                    <Border Grid.Row="2"
                            Background="#FFF4CC"
                            BorderBrush="#EAAA08"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,0,6"
                            Padding="10,8"
                            Visibility="{Binding RawXml.IsTruncated, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#7A2E0E"
                                   Text="{Binding RawXml.TruncationNotice}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <DockPanel Grid.Row="3" Margin="0,0,0,6">
                        <Button Command="{Binding RawXml.CopyPreviewCommand}"
                                Content="复制预览"
                                DockPanel.Dock="Right"
                                Padding="10,4" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding RawXml.LengthSummary}" />
                    </DockPanel>
                    <TextBox Grid.Row="4"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="13"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Text="{Binding RawXml.PreviewText, Mode=OneWay}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="实时接入预览">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0 is deliberately outside the ScrollViewer: the persistence
                         disclosure must stay visible no matter how far the page scrolls. -->
                    <Border x:Name="LivePersistenceDisclosure"
                            Grid.Row="0"
                            Background="#FDECEA"
                            BorderBrush="#B42318"
                            BorderThickness="2"
                            CornerRadius="4"
                            Margin="12,12,12,0"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Foreground="#B42318"
                                       Text="重要：数据保存范围"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#B42318"
                                       Text="{Binding LiveMonitoring.Disclosure}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Background="#FFF4CC"
                                BorderBrush="#EAAA08"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#7A2E0E"
                                       Text="{Binding LiveMonitoring.Disclaimer}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="当前状态：" />
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding LiveMonitoring.StateLabel}" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,10,4"
                                       Text="Sysmon 通道" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Margin="0,0,0,4"
                                       Text="{Binding LiveMonitoring.SysmonChannelStatus}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,10,0"
                                       Text="Security 通道" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding LiveMonitoring.SecurityChannelStatus}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button Command="{Binding LiveMonitoring.ProbeChannelsCommand}"
                                    Content="检测通道"
                                    Padding="14,8" />
                            <Button Command="{Binding LiveMonitoring.StartCommand}"
                                    Content="开始监控"
                                    Margin="8,0,0,0"
                                    Padding="14,8" />
                            <Button Command="{Binding LiveMonitoring.StopCommand}"
                                    Content="停止监控"
                                    Margin="8,0,0,0"
                                    Padding="14,8" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   Text="{Binding LiveMonitoring.CountersSummary}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding LiveMonitoring.ClassificationSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding LiveMonitoring.QueueSummary}" />

                        <Border Background="#FDECEA"
                                BorderBrush="#B42318"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Visibility="{Binding LiveMonitoring.HasDropped, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#B42318"
                                       Text="事件队列已满，部分事件被丢弃；丢弃数量见上方统计。"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource ErrorText}"
                                   Text="{Binding LiveMonitoring.LastError}"
                                   Visibility="{Binding LiveMonitoring.HasLastError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding LiveMonitoring.ErrorMessage}" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="实时接入历史">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0 stays outside the working area: what this page is, and what
                         it deliberately does not do, must remain visible at all times. -->
                    <Border Grid.Row="0"
                            Background="#EEF4FF"
                            BorderBrush="#2F5BB7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <TextBlock Text="{Binding LiveHistory.Disclosure}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="开始时间 (UTC)" />
                        <TextBox Width="165"
                                 AutomationProperties.Name="按开始时间筛选，UTC"
                                 Text="{Binding LiveHistory.FromUtcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="12,0,6,0"
                                   Style="{StaticResource FilterLabel}"
                                   Text="结束时间 (UTC)" />
                        <TextBox Width="165"
                                 AutomationProperties.Name="按结束时间筛选，UTC"
                                 Text="{Binding LiveHistory.ToUtcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="只看有错误的记录"
                                  IsChecked="{Binding LiveHistory.ErrorsOnly, Mode=TwoWay}" />
                        <CheckBox Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="接收序号倒序"
                                  IsChecked="{Binding LiveHistory.NewestFirst, Mode=TwoWay}" />
                        <Button Command="{Binding LiveHistory.ApplyFiltersCommand}"
                                Content="筛选会话"
                                Margin="12,0,0,0"
                                Padding="10,4" />
                        <Button Command="{Binding LiveHistory.ApplyRecordFiltersCommand}"
                                Content="筛选记录"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                        <Button Command="{Binding LiveHistory.RefreshCommand}"
                                Content="刷新"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                        <Button Command="{Binding LiveHistory.AnalyzeCommand}"
                                Content="分析所选会话"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                    </WrapPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding LiveHistory.UnavailableMessage}"
                                   Visibility="{Binding LiveHistory.IsUnavailable, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding LiveHistory.ErrorMessage}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="没有符合条件的实时接入会话。"
                                   Visibility="{Binding LiveHistory.IsSessionListEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sessions -->
                        <Grid Grid.Column="0" Margin="0,0,6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      AutomationProperties.Name="实时接入会话列表"
                                      ItemsSource="{Binding LiveHistory.Sessions}"
                                      SelectedItem="{Binding LiveHistory.SelectedSession, Mode=TwoWay}"
                                      Style="{StaticResource VirtualizedDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding StartedUtc}" Header="开始 (UTC)" />
                                    <DataGridTextColumn Binding="{Binding FinalState, Converter={StaticResource UnknownValue}}" Header="结束状态" />
                                    <DataGridTextColumn Binding="{Binding ReceivedCount}" Header="接收" />
                                    <DataGridTextColumn Binding="{Binding DeleteFactCount}" Header="删除事实" />
                                    <DataGridTextColumn Binding="{Binding StoredRecordCount}" Header="已保存" />
                                    <DataGridTextColumn Binding="{Binding LiveSessionId}" Header="会话 ID" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding LiveHistory.SessionPageStatus}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding LiveHistory.PreviousSessionPageCommand}"
                                            Content="上一页"
                                            Padding="10,4" />
                                    <Button Command="{Binding LiveHistory.NextSessionPageCommand}"
                                            Content="下一页"
                                            Margin="8,0,0,0"
                                            Padding="10,4" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <!-- Records, diagnostics and the selected record's raw XML -->
                        <Grid Grid.Column="1" Margin="6,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding LiveHistory.SelectedSessionSummary}"
                                           TextWrapping="Wrap" />
                                <Border Background="#FFF4E5"
                                        BorderBrush="#B54708"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,6,0,0"
                                        Padding="10,8"
                                        Visibility="{Binding LiveHistory.SelectedSessionIsIncomplete, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Foreground="#B54708"
                                               Text="该会话没有完成记录，本次接入可能异常中断；上面的计数不完整。"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Margin="0,4,0,0"
                                           Text="该会话没有已保存的记录。"
                                           Visibility="{Binding LiveHistory.IsRecordListEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      Margin="0,6,0,0"
                                      AutomationProperties.Name="实时接入记录列表"
                                      ItemsSource="{Binding LiveHistory.Records}"
                                      SelectedItem="{Binding LiveHistory.SelectedRecord, Mode=TwoWay}"
                                      Style="{StaticResource VirtualizedDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding ReceivedSequence}" Header="序号" />
                                    <DataGridTextColumn Binding="{Binding Outcome}" Header="分类" />
                                    <DataGridTextColumn Binding="{Binding ObservedUtc}" Header="接收时间 (UTC)" />
                                    <DataGridTextColumn Binding="{Binding ProviderName, Converter={StaticResource UnknownValue}}" Header="Provider" />
                                    <DataGridTextColumn Binding="{Binding ChannelName}" Header="通道" />
                                    <DataGridTextColumn Binding="{Binding ParsedEventId, Converter={StaticResource UnknownValue}}" Header="Event ID" />
                                    <DataGridTextColumn Binding="{Binding EventRecordId, Converter={StaticResource UnknownValue}}" Header="Record ID" />
                                    <DataGridTextColumn Binding="{Binding ErrorCode, Converter={StaticResource UnknownValue}}" Header="错误码" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding LiveHistory.RecordPageStatus}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding LiveHistory.PreviousRecordPageCommand}"
                                            Content="上一页"
                                            Padding="10,4" />
                                    <Button Command="{Binding LiveHistory.NextRecordPageCommand}"
                                            Content="下一页"
                                            Margin="8,0,0,0"
                                            Padding="10,4" />
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                <TextBlock Text="{Binding LiveHistory.SelectedRecordSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding LiveHistory.RawXmlLengthSummary}" />
                                <Border Background="#FFF4E5"
                                        BorderBrush="#B54708"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,6,0,0"
                                        Padding="10,8"
                                        Visibility="{Binding LiveHistory.RawXmlIsTruncated, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Foreground="#B54708"
                                               Text="{Binding LiveHistory.RawXmlTruncationNotice}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <TextBox Grid.Row="4"
                                     Margin="0,6,0,0"
                                     AutomationProperties.Name="所选记录的只读原始 XML 预览"
                                     FontFamily="Consolas"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     Text="{Binding LiveHistory.RawXmlPreview, Mode=OneWay}"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="实时接入分析">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#EEF4FF"
                            BorderBrush="#2F5BB7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <TextBlock TextWrapping="Wrap"
                                   Text="本页是对「实时接入历史」中所选会话的只读派生分析：重新读取并解析该会话已保存的记录，套用与离线导入完全相同的确定性关联、删除会话归并与风险规则。分析结果不会写回数据库，也不会成为新的证据；关联表示证据之间的印证，不是攻击确认或责任判定。请先在「实时接入历史」页选择一个会话，再点击该页的“分析所选会话”。" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding LiveHistory.AnalysisSummary}"
                                   TextWrapping="Wrap" />
                        <Border Background="#FFF4E5"
                                BorderBrush="#B54708"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,6,0,0"
                                Padding="10,8"
                                Visibility="{Binding LiveHistory.AnalysisWasTruncated, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#B54708"
                                       Text="{Binding LiveHistory.AnalysisTruncationNotice}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Margin="0,4,0,0"
                                   Text="该会话没有可分析的删除事实。"
                                   Visibility="{Binding LiveHistory.AnalysisIsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="派生的删除会话列表"
                              ItemsSource="{Binding LiveHistory.AnalysisSessions}"
                              Style="{StaticResource VirtualizedDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Ordinal}" Header="#" />
                            <DataGridTextColumn Binding="{Binding RiskLevel}" Header="风险信号" />
                            <DataGridTextColumn Binding="{Binding RiskRuleCode}" Header="规则" />
                            <DataGridTextColumn Binding="{Binding ConfirmedItemCount}" Header="删除数" />
                            <DataGridTextColumn Binding="{Binding ProtectedItemCount}" Header="受保护路径" />
                            <DataGridTextColumn Binding="{Binding OpenedUtc}" Header="开始 (UTC)" />
                            <DataGridTextColumn Binding="{Binding LastEventUtc}" Header="最后事件 (UTC)" />
                            <DataGridTextColumn Binding="{Binding ProcessIdentity}" Header="进程标识" />
                            <DataGridTextColumn Binding="{Binding UserIdentity}" Header="用户标识" />
                            <DataGridTextColumn Binding="{Binding MainPath}" Header="路径范围" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="3"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="派生的关联删除事件列表"
                              ItemsSource="{Binding LiveHistory.AnalysisDeletes}"
                              Style="{StaticResource VirtualizedDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding DeleteSessionOrdinal}" Header="会话 #" />
                            <DataGridTextColumn Binding="{Binding OccurredUtc}" Header="发生时间 (UTC)" />
                            <DataGridTextColumn Binding="{Binding FullPath, Converter={StaticResource UnknownValue}}" Header="路径" Width="*" />
                            <DataGridTextColumn Binding="{Binding Method}" Header="关联方式" />
                            <DataGridTextColumn Binding="{Binding Confidence}" Header="置信度" />
                            <DataGridTextColumn Binding="{Binding RiskLevel}" Header="风险信号" />
                            <DataGridTextColumn Binding="{Binding ProcessPath, Converter={StaticResource UnknownValue}}" Header="进程" />
                            <DataGridTextColumn Binding="{Binding UserName, Converter={StaticResource UnknownValue}}" Header="用户" />
                            <DataGridTextColumn Binding="{Binding ReceivedSequence}" Header="接收序号" />
                            <DataGridTextColumn Binding="{Binding LiveEvidenceId}" Header="来源证据 ID" />
                            <DataGridTextColumn Binding="{Binding MatchedProcessLiveEvidenceId, Converter={StaticResource UnknownValue}}" Header="匹配的进程证据" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="实时规范投影">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#EEF4FF"
                            BorderBrush="#2F5BB7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <TextBlock Text="{Binding LiveProjection.Disclosure}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding LiveProjection.SelectedSessionSummary}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button AutomationProperties.Name="投影所选实时接入会话"
                                    Command="{Binding LiveProjection.ProjectCommand}"
                                    Content="投影所选会话"
                                    Padding="12,6" />
                            <Button AutomationProperties.Name="刷新实时规范投影"
                                    Command="{Binding LiveProjection.RefreshCommand}"
                                    Content="刷新投影记录"
                                    Margin="8,0,0,0"
                                    Padding="12,6" />
                            <Button AutomationProperties.Name="验证实时投影连续性"
                                    Command="{Binding LiveProjection.VerifyCommand}"
                                    Content="验证连续性"
                                    Margin="8,0,0,0"
                                    Padding="12,6" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="正在执行…"
                                       Visibility="{Binding LiveProjection.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FilterLabel}"
                                       Text="来源" />
                            <ComboBox Width="170"
                                      AutomationProperties.Name="投影来源筛选"
                                      ItemsSource="{Binding LiveProjection.SourceOptions}"
                                      SelectedItem="{Binding LiveProjection.Source, Mode=TwoWay}" />
                            <TextBlock Margin="12,0,6,0"
                                       Style="{StaticResource FilterLabel}"
                                       Text="路径包含" />
                            <TextBox Width="220"
                                     AutomationProperties.Name="投影路径筛选"
                                     Text="{Binding LiveProjection.PathContains, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,6,0"
                                       Style="{StaticResource FilterLabel}"
                                       Text="进程包含" />
                            <TextBox Width="220"
                                     AutomationProperties.Name="投影进程筛选"
                                     Text="{Binding LiveProjection.ProcessContains, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="最新序号优先"
                                      IsChecked="{Binding LiveProjection.Descending}" />
                            <Button Command="{Binding LiveProjection.ApplyFiltersCommand}"
                                    Content="应用筛选"
                                    Margin="12,0,0,0"
                                    Padding="10,4" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding LiveProjection.AvailabilityMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding LiveProjection.LastRunSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding LiveProjection.ContinuitySummary}"
                                   TextWrapping="Wrap" />
                        <Border Background="#FEE4E2"
                                BorderBrush="#B42318"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,6,0,0"
                                Padding="10,8"
                                Visibility="{Binding LiveProjection.IsUnavailable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#B42318"
                                       Text="{Binding LiveProjection.AvailabilityMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border Background="#FEE4E2"
                                BorderBrush="#B42318"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,6,0,0"
                                Padding="10,8"
                                Visibility="{Binding LiveProjection.LastRunFailed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#B42318"
                                       Text="{Binding LiveProjection.LastRunSummary}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border Background="#FFF4E5"
                                BorderBrush="#B54708"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,6,0,0"
                                Padding="10,8"
                                Visibility="{Binding LiveProjection.ContinuityIsBroken, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#B54708"
                                       Text="{Binding LiveProjection.ContinuitySummary}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding LiveProjection.ErrorMessage}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="该筛选条件下没有投影记录。"
                                   Visibility="{Binding LiveProjection.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <DataGrid Grid.Row="3"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="实时规范投影记录列表"
                              ItemsSource="{Binding LiveProjection.Records}"
                              Style="{StaticResource VirtualizedDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding LiveIngestSequence}"
                                                Header="Live 序号" />
                            <DataGridTextColumn Binding="{Binding SourceReceivedSequence}"
                                                Header="接收序号" />
                            <DataGridTextColumn Binding="{Binding SourceLabel}"
                                                Header="来源分类" />
                            <DataGridTextColumn Binding="{Binding EventUtc, Converter={StaticResource UnknownValue}}"
                                                Header="事件时间 (UTC)" />
                            <DataGridTextColumn Binding="{Binding NormalizedPath, Converter={StaticResource UnknownValue}}"
                                                Header="路径"
                                                Width="*" />
                            <DataGridTextColumn Binding="{Binding ProcessPath, Converter={StaticResource UnknownValue}}"
                                                Header="进程" />
                            <DataGridTextColumn Binding="{Binding ProcessId, Converter={StaticResource UnknownValue}}"
                                                Header="PID" />
                            <DataGridTextColumn Binding="{Binding UserName, Converter={StaticResource UnknownValue}}"
                                                Header="用户" />
                            <DataGridTextColumn Binding="{Binding LiveEvidenceId}"
                                                Header="Live evidence ID" />
                            <DataGridTextColumn Binding="{Binding LiveChannelEpochId}"
                                                Header="Live epoch ID" />
                            <DataGridTextColumn Binding="{Binding LiveProjectionId}"
                                                Header="Projection ID" />
                            <DataGridTextColumn Binding="{Binding EntryHash}"
                                                Header="Entry hash" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding LiveProjection.PageStatus}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding LiveProjection.PreviousPageCommand}"
                                    Content="上一页"
                                    Padding="10,4" />
                            <Button Command="{Binding LiveProjection.NextPageCommand}"
                                    Content="下一页"
                                    Margin="8,0,0,0"
                                    Padding="10,4" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
