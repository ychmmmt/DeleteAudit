# Normalise line endings so every clone is byte-identical regardless of the
# contributor's core.autocrlf setting. Several tests compare XML round-trips,
# and XML parsing normalises CRLF to LF, so the working tree must be LF.
* text=auto eol=lf

# Explicit for the file types that matter most to the tests and the build.
*.cs        text eol=lf
*.xaml      text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.sln       text eol=lf
*.config    text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.gitignore text eol=lf

# Binary: never transform.
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.zip       binary
*.evtx      binary
*.db        binary
